LLM_MODE=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# macOS / 部分环境 SSL 证书链不完整时，可指向 certifi 的 cacert.pem
# 获取路径: python3 -c "import certifi; print(certifi.where())"
SSL_CERT_FILE=

# 合同远程 id 解析：stub=内置假数据；http=HTTP 拉取；none=禁止仅用 id
CONTRACT_DOCUMENT_PROVIDER=stub

# HTTP 模式（CONTRACT_DOCUMENT_PROVIDER=http）示例：
# CONTRACT_DOCUMENT_HTTP_BASE_URL=https://your-api.example.com
# CONTRACT_DOCUMENT_HTTP_PATH_TEMPLATE=/api/contracts/{doc_id}
# CONTRACT_DOCUMENT_HTTP_TIMEOUT=30
# CONTRACT_DOCUMENT_HTTP_BEARER_TOKEN=
# 可选：点分路径从 JSON 中取正文（如 data.textContent）；不设置则沿用内置字段启发式
# CONTRACT_DOCUMENT_HTTP_JSON_PATH=data.textContent
# 可选：额外请求头（JSON 对象，值会转为字符串），如租户、API Key、签名头
# CONTRACT_DOCUMENT_HTTP_HEADERS={"X-Tenant-Id":"acme","X-Api-Key":"..."}

# 审查子任务并发（默认 10，与 Dify 常见迭代并发接近；范围 1–32）
REVIEW_TASK_MAX_WORKERS=10
